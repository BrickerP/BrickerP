{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heartbeat",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MONITOR",
        "class_name": "Monitor"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Monitor"]
    }
  ]
}
