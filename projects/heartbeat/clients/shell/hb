#!/usr/bin/env bash
# hb — heartbeat shell client.
#
#   hb <monitor-url> <token>                      send a plain beat
#   hb <monitor-url> <token> -- <command> [args]  time <command>, report duration + exit code
#   hb -- <command> [args]                        same, using $HEARTBEAT_URL / $HEARTBEAT_TOKEN
#
# <monitor-url> is https://<worker>/v1/monitors/<id> (a trailing /beat is accepted too).
#
# Environment:
#   HEARTBEAT_URL, HEARTBEAT_TOKEN   defaults for the positional arguments
#   HEARTBEAT_TIMEOUT                curl timeout in seconds (default 10)
#   HEARTBEAT_QUIET=1                suppress warnings when the beat cannot be delivered
#   HEARTBEAT_VERBOSE=1              print the server response on success
#
# In command mode the wrapper is transparent: stdin/stdout/stderr belong to the command and
# hb always exits with the command's exit code, even if the beat could not be delivered.
# A non-zero exit code is reported as status "fail" so the monitor opens a `fail` incident.

set -u

usage() {
  awk 'NR > 1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "$0"
}

warn() {
  [ -n "${HEARTBEAT_QUIET:-}" ] || printf 'hb: %s\n' "$*" >&2
}

# Milliseconds since the epoch, portably: bash 5 EPOCHREALTIME, GNU date, python3, perl, then seconds.
now_ms() {
  local ns
  if [ -n "${EPOCHREALTIME:-}" ]; then
    local us=${EPOCHREALTIME/./}
    printf '%s\n' $(( 10#$us / 1000 ))
    return
  fi
  ns=$(date +%s%N 2>/dev/null)
  case $ns in
    ''|*[!0-9]*) ;;
    *) printf '%s\n' $(( ns / 1000000 )); return ;;
  esac
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import time; print(int(time.time() * 1000))'
  elif command -v perl >/dev/null 2>&1; then
    perl -MTime::HiRes=time -e 'printf("%d\n", time() * 1000)'
  else
    printf '%s\n' $(( $(date +%s) * 1000 ))
  fi
}

# Escape a string for use inside a JSON string literal (control characters are dropped).
json_escape() {
  local s
  s=$(printf '%s' "$1" | LC_ALL=C tr -d '\000-\010\013\014\016-\037')
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\t'/\\t}
  s=${s//$'\r'/\\r}
  printf '%s' "$s"
}

beat_url() {
  local u=${1%/}
  case $u in
    */beat) printf '%s' "$u" ;;
    *) printf '%s/beat' "$u" ;;
  esac
}

# send_beat <json-payload>; returns non-zero if the beat was not accepted.
send_beat() {
  local payload=$1 response
  if ! command -v curl >/dev/null 2>&1; then
    warn "curl not found; beat skipped"
    return 1
  fi
  if response=$(curl -fsS -m "${HEARTBEAT_TIMEOUT:-10}" --retry 2 \
      -X POST "$(beat_url "$url")" \
      -H "Authorization: Bearer $token" \
      -H 'Content-Type: application/json' \
      --data "$payload" 2>&1); then
    [ -z "${HEARTBEAT_VERBOSE:-}" ] || printf '%s\n' "$response"
    return 0
  fi
  warn "beat not delivered: ${response:-curl failed}"
  return 1
}

# ---- argument parsing -------------------------------------------------------------------

positional=()
command_mode=0
while [ $# -gt 0 ]; do
  case $1 in
    -h|--help) usage; exit 0 ;;
    --) shift; command_mode=1; break ;;
    -*) printf 'hb: unknown option %s\n' "$1" >&2; usage >&2; exit 2 ;;
    *) positional+=("$1"); shift ;;
  esac
done

case ${#positional[@]} in
  0) url=${HEARTBEAT_URL:-}; token=${HEARTBEAT_TOKEN:-} ;;
  2) url=${positional[0]}; token=${positional[1]} ;;
  *) printf 'hb: expected <monitor-url> <token> (or none, with HEARTBEAT_URL/HEARTBEAT_TOKEN set)\n' >&2
     usage >&2; exit 2 ;;
esac

if [ "$command_mode" -eq 1 ] && [ $# -eq 0 ]; then
  printf 'hb: no command given after --\n' >&2
  exit 2
fi

host=$(json_escape "${HOSTNAME:-$(hostname 2>/dev/null || echo unknown)}")

# ---- plain beat ---------------------------------------------------------------------------

if [ "$command_mode" -eq 0 ]; then
  if [ -z "$url" ] || [ -z "$token" ]; then
    warn "no url/token configured (pass them or set HEARTBEAT_URL/HEARTBEAT_TOKEN)"
    exit 2
  fi
  send_beat "{\"status\":\"ok\",\"meta\":{\"host\":\"$host\"}}"
  exit $?
fi

# ---- command mode -------------------------------------------------------------------------

started=$(now_ms)
"$@"
code=$?
finished=$(now_ms)

duration=$(( finished - started ))
[ "$duration" -ge 0 ] || duration=0
if [ "$code" -eq 0 ]; then status=ok; else status=fail; fi

cmd_text="$*"
[ ${#cmd_text} -le 500 ] || cmd_text="${cmd_text:0:497}..."

if [ -z "$url" ] || [ -z "$token" ]; then
  warn "no url/token configured (pass them or set HEARTBEAT_URL/HEARTBEAT_TOKEN); beat skipped"
else
  send_beat "{\"durationMs\":$duration,\"status\":\"$status\",\"meta\":{\"exitCode\":$code,\"command\":\"$(json_escape "$cmd_text")\",\"host\":\"$host\"}}" || true
fi

exit "$code"
